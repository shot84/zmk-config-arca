+	arca_lll_dump.radio_isr_age = (int32_t)ticker_ticks_diff_get(now, arca_radio_isr_ticks);
+	arca_lll_dump.preempt_age = (int32_t)ticker_ticks_diff_get(now, arca_preempt_ticks);
+	arca_lll_dump.abort_age = (int32_t)ticker_ticks_diff_get(now, arca_abort_ticks);
+	arca_lll_dump.abort_count = arca_abort_count;
+	arca_lll_dump.radio_isr_count = arca_radio_isr_count;
+	arca_lll_dump.recoveries = (uint8_t)arca_lll_recoveries;
+	arca_lll_dump.recovered = 0U;
+	while ((e = ull_prepare_dequeue_iter(&idx)) && n < ARCA_LLL_DUMP_N) {
+		arca_role_name(e->prepare_param.param, arca_lll_dump.pipe[n]);
+		arca_lll_dump.pipe_resume[n] = e->is_resume;
+		arca_lll_dump.pipe_lazy[n] = e->prepare_param.lazy;
+		arca_lll_dump.pipe_dt[n] = (int32_t)ticker_ticks_diff_get(e->prepare_param.ticks_at_expire, now);
+		n++;
+	}
