+	arca_lll_dump.magic = ARCA_LLL_DUMP_MAGIC;
+}
+
+/* Arca (2026-09-07): the pipeline overflow is a *symptom*. Two dumps (v3/v4) showed the same thing:
+ * the current event (C1 = split link) never completes — radio DISABLED, no radio IRQ for 245 ms,
+ * armed ISR = lll_conn_isr_rx (its RX phase silently died; no flash op involved) — and every 7.5 ms
+ * the next prepare of the *same* connection is refused by is_abort_cb (-EBUSY: no trx yet), so nobody
+ * ever aborts it; 47 prepares (3 per 15 ms) pile up and LL_ASSERT(next) resets the SoC.
+ * Deepening the pipeline only delays the assert. Two nets instead:
+ *   (a) arca_lll_watchdog(): from preempt(), a current event older than ARCA_STUCK_EVENT_US whose radio
+ *       sits DISABLED with no IRQ pending/no DISABLED event is completed synchronously (its interrupt is
+ *       never coming). Stale prepares are flushed first so the dequeue does not run a hopelessly late one.
+ *   (b) arca_lll_recover(): if the pipeline still overflows, flush stale prepares, complete the stuck
+ *       event (if any), then re-resolve this prepare (curr is free and the pipeline empty -> it runs).
+ * The first attempt of (b) crashed on LL_ASSERT_OVERHEAD when the dequeue ran a 240 ms-late prepare;
+ * hence the flush, and CONFIG_BT_CTLR_ASSERT_OVERHEAD_START=n in the Arca .conf files. */
+#define ARCA_STUCK_EVENT_US   40000U /* no legitimate event outlives its 7.5/15 ms interval by this much with the radio idle */
+#define ARCA_STALE_PREPARE_US 3000U  /* a prepare whose expiry passed more than this ago would only fail its overhead check */
+
+static uint8_t arca_in_recovery;
+
+static void arca_lll_phase_done(void)
+{
+	if (arca_lll_recoveries && arca_lll_dump.phase >= 30U) {
+		arca_lll_dump.phase = 31U;   /* an event completed normally after a recovery */
+	}
+}
+
+/* Post the done-extra so ULL sees an *aborted* conn event (supervision/latency bookkeeping stays right). */
+static void arca_conn_done_extra(void *param)
+{
+	char role[4];
+
+	arca_role_name(param, role);
+	if (role[0] == 'C' || role[0] == 'P') {
+		struct event_done_extra *e = ull_event_done_extra_get();
+
+		if (e) {
+			e->type = EVENT_DONE_EXTRA_TYPE_CONN;
+			e->trx_cnt = 0U;
+			e->crc_valid = 0U;
+			e->is_aborted = 1U;
+#if defined(CONFIG_BT_CTLR_LE_ENC)
+			e->mic_state = 0U; /* LLL_CONN_MIC_NONE */
+#endif /* CONFIG_BT_CTLR_LE_ENC */
+		}
+	}
+}
+
+/* Mark stale prepares aborted with the bookkeeping their abort_cb would have done, but without posting
+ * a done per entry (the done pool holds ~8, a flooded pipeline 47). ull_prepare_dequeue() drops aborted
+ * entries silently; the next real event catches the event counter up through latency_prepare. */
+static uint8_t arca_lll_flush_stale(uint32_t now)
+{
+	uint8_t idx = UINT8_MAX;
+	uint8_t n = 0U;
+	struct lll_event *e;
+
+	while ((e = ull_prepare_dequeue_iter(&idx))) {
+		struct lll_prepare_param *pp = &e->prepare_param;
+		uint32_t late;
+		char role[4];
+
+		if (e->is_aborted) {
+			continue;
+		}
+		late = ticker_ticks_diff_get(now, pp->ticks_at_expire);
+		if ((late & BIT(HAL_TICKER_CNTR_MSBIT)) ||           /* expiry still ahead */
+		    (late < HAL_TICKER_US_TO_TICKS(ARCA_STALE_PREPARE_US))) {
+			continue;
+		}
+		e->is_aborted = 1U;
+		arca_role_name(pp->param, role);
+		if (role[0] == 'C' || role[0] == 'P') {           /* what lll_conn_abort_cb(prepare_param) does */
+			struct lll_conn *lll = pp->param;
+
+			lll->lazy_prepare = pp->lazy;
+			lll->latency_prepare += (pp->lazy + 1U);
+#if defined(CONFIG_BT_PERIPHERAL)
+			if (lll->role == BT_HCI_ROLE_PERIPHERAL) {
+				lll->periph.window_widening_prepare_us +=
+					lll->periph.window_widening_periodic_us * (pp->lazy + 1U);
+				if (lll->periph.window_widening_prepare_us >
+				    lll->periph.window_widening_max_us) {
+					lll->periph.window_widening_prepare_us =
+						lll->periph.window_widening_max_us;
+				}
+			}
+#endif /* CONFIG_BT_PERIPHERAL */
+		}
+		(void)lll_hfclock_off();                          /* the ref its lll_*_prepare() took */
+		n++;
+	}
+
+	return n;
+}
+
+/* Complete a current event that will never complete on its own (its radio interrupt is not coming).
+ * how: 1 = pipeline overflow path, 2 = watchdog in preempt(). */
+static void arca_lll_complete_curr(uint8_t how)
+{
+	if (!event.curr.abort_cb || !event.curr.param) {
+		return;
+	}
+	arca_conn_done_extra(event.curr.param);
+	/* isr = isr_race, radio_disable if busy, tmr stop, hfclock off, lll_done(NULL) -> ull_prepare_dequeue */
+	lll_isr_cleanup(event.curr.param);
+	arca_lll_recoveries++;
+	arca_lll_dump.recoveries = (uint8_t)arca_lll_recoveries;
+	arca_lll_dump.recovered = how;
+}
+
+static bool arca_lll_curr_is_dead(uint32_t now)
+{
+	if (!event.curr.abort_cb || !event.curr.param) {
+		return false;
+	}
+	if (ticker_ticks_diff_get(now, arca_curr_start_ticks) <
+	    HAL_TICKER_US_TO_TICKS(ARCA_STUCK_EVENT_US)) {
+		return false;
+	}
+	return radio_is_idle() && !NVIC_GetPendingIRQ(RADIO_IRQn) && !NRF_RADIO->EVENTS_DISABLED;
+}
+
+/* (b) pipeline overflow: make room, then let the caller re-resolve this prepare. */
+static void arca_lll_recover(void)
+{
+	uint32_t now = ticker_ticks_now_get();
+
+	(void)arca_lll_flush_stale(now);
+	if (event.curr.abort_cb && event.curr.param) {
+		arca_lll_complete_curr(1U);
+	} else {
+		ull_prepare_dequeue(TICKER_USER_ID_LLL);      /* drop the flushed entries, resume fresh ones */
+	}
+}
+
 int lll_prepare_resolve(lll_is_abort_cb_t is_abort_cb, lll_abort_cb_t abort_cb,
 			lll_prepare_cb_t prepare_cb,
 			struct lll_prepare_param *prepare_param,
@@ -888,6 +1182,18 @@ int lll_prepare_resolve(lll_is_abort_cb_t is_abort_cb, lll_abort_cb_t abort_cb,
 		/* Store the next prepare for deferred call */
 		next = ull_prepare_enqueue(is_abort_cb, abort_cb, prepare_param,
 					   prepare_cb, is_resume);
+		if (!next && !arca_in_recovery) {
+			arca_lll_capture(prepare_param, is_resume);
+			arca_in_recovery = 1U;
+			arca_lll_recover();
+			arca_lll_dump.phase = 21U;
+			/* curr is free and the stale entries are gone: resolve again (runs it, or enqueues it) */
+			err = lll_prepare_resolve(is_abort_cb, abort_cb, prepare_cb, prepare_param,
+						  is_resume, is_dequeue);
+			arca_in_recovery = 0U;
+			arca_lll_dump.phase = 22U;
+			return err;
+		}
 		LL_ASSERT(next);
 
 #if !defined(CONFIG_BT_CTLR_LOW_LAT)
@@ -946,6 +1252,10 @@ int lll_prepare_resolve(lll_is_abort_cb_t is_abort_cb, lll_abort_cb_t abort_cb,
 	LL_ASSERT(!ready || &ready->prepare_param == prepare_param);
 
 	event.curr.param = prepare_param->param;
+	arca_curr_start_ticks = ticker_ticks_now_get();
+	if (arca_lll_recoveries) {
+		arca_lll_dump.phase = 30U;
+	}
 	event.curr.is_abort_cb = is_abort_cb;
 	event.curr.abort_cb = abort_cb;
 
@@ -1210,10 +1520,26 @@ static void preempt(void *param)
 	uint8_t idx;
 	int err;
 
+	arca_preempt_ticks = ticker_ticks_now_get();
