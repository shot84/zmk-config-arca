+	/* (a) Arca watchdog: a current event whose radio interrupt is never coming (see arca_lll_recover) */
+	if (arca_lll_curr_is_dead(arca_preempt_ticks)) {
+		arca_lll_capture(NULL, 0U);
+		(void)arca_lll_flush_stale(arca_preempt_ticks);
+		arca_lll_dump.phase = 11U;
+		arca_lll_complete_curr(2U);   /* lll_done(NULL) -> ull_prepare_dequeue runs the fresh preemptor */
+		arca_lll_dump.phase = 12U;
+		arca_preempt_err = 'w';
+		arca_lll_dump.phase = 13U;
+		return;
+	}
+
 	/* No event to abort */
 	if (!event.curr.abort_cb || !event.curr.param) {
 		return;
 	}
+	arca_preempt_err = 'r';
 
