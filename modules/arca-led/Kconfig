# ══════════════════════════════════════════════════════════════════════
# 検死装置 — フォルトの現場（PC/LR/スレッド名/CFSR）を __noinit に記録し次の起動で印字。
# 出力経路が巻き添えで死ぬ障害では「その場のログ」が原理的に残らない（2026-08-31 実録）。
config ARCA_AUTOPSY
    bool "Arca crash autopsy (record fatal PC/thread across reset)"
    default y
    select THREAD_NAME

config ARCA_LED_DEBUG_FLASH_MARKER
    bool "前回のリセットがフラッシュ操作中だったら起動時に白で点滅（消去=3回／書き込み=2回）"
    default n
    help
      ★2026-09-04 の L 断続リセット調査の道具（widget.c indicate_flash_op_at_reset）。
      2026-10-16 にユーザー「表面に出してるデバッグ的な機能消してほしい」で既定 n。
